MONGODB_URI=mongodb://localhost:27017/juvion_v2
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-strong-secret
PORT=3003
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# AI
AI_PROVIDER=openai
AI_API_KEY=change-me

# AWS S3 (optional). Used for student/faculty/staff photo uploads, faculty
# document storage, and bulk-import source-file archiving. Leaving
# AWS_S3_BUCKET unset disables bulk-import source-file archiving only (the
# import itself still succeeds, just without an archived copy); photo and
# faculty-document uploads still return 503 if attempted without a bucket.
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=

# Communication channels
WHATSAPP_API_URL=https://api.whatsapp.com/placeholder
SMS_GATEWAY_URL=https://sms-gateway.example.com
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=noreply@juvion.in

# Juvi mobile app
JUVI_CREDENTIAL_KEY=            # 32 bytes base64 (openssl rand -base64 32). Required in production; dev falls back to a fixed key.
JUVI_RECONCILE_INTERVAL_MINUTES=5
JUVI_IOS_STORE_URL=             # set once the iOS app is published
TRUST_PROXY_HOPS=            # number of reverse proxies in front of the API (1 for nginx); unset = trust none
