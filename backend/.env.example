MONGODB_URI=mongodb://localhost:27017/juvion_v2
RBAC_ENFORCE=false
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-strong-secret
PORT=3003
CLIENT_URL=http://localhost:5173
NODE_ENV=development

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,https://admin.juvion.in

# AI
AI_PROVIDER=openai
AI_API_KEY=change-me


# Email (SMTP) — used for interview invites and notifications
# Works with Gmail (use an App Password), SendGrid, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Juvion Admissions <admissions@yourschool.com>"

ANTHROPIC_API_KEY=your_anthropic_api_key

# Object storage — works with AWS S3 or any S3-compatible provider (DigitalOcean Spaces, etc.)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=your_storage_region
AWS_S3_BUCKET_NAME=your_bucket_name
AWS_S3_ENDPOINT=your_storage_endpoint